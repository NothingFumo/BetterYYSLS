<Page x:Class="BetterYYSLS.View.Pages.MapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pages="clr-namespace:BetterYYSLS.ViewModel.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="MapPage"
      d:DataContext="{d:DesignInstance Type=pages:MapPageViewModel}"
      d:DesignHeight="720"
      d:DesignWidth="900"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      FontFamily="{StaticResource TextThemeFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="42,16,42,24">
            <ui:TextBlock FontTypography="Title" Text="大地图" />
            <ui:TextBlock Margin="0,6,0,18"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="悬浮在游戏之上浏览 Godlike 地图数据、筛选标记并生成宏观路线。" />

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="地图窗口" />
                    <ui:TextBlock Margin="0,4,0,14"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  Text="默认浮动小窗，可切换全屏；开启穿透后鼠标交给游戏。" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Command="{Binding OpenMapCommand}"
                                   Content="打开大地图"
                                   Margin="0,0,8,0" />
                        <ui:Button Command="{Binding ImportSnapshotCommand}"
                                   Content="导入快照"
                                   Margin="0,0,8,0" />
                        <ui:Button Command="{Binding OpenLoginCommand}"
                                   Content="扫码登录"
                                   Margin="0,0,8,0" />
                        <ui:Button Command="{Binding SyncGodlikeCommand}"
                                   Content="同步 Godlike"
                                   Margin="0,0,8,0" />
                        <ui:Button Command="{Binding Map.RefreshSessionCommand}"
                                   Content="刷新登录态"
                                   Margin="0,0,8,0" />
                        <ui:Button Command="{Binding Map.OpenOfficialClientCommand}"
                                   Content="启动官方客户端"
                                   Margin="0,0,8,0" />
                        <ui:Button Command="{Binding ToggleFullScreenCommand}"
                                   Content="全屏"
                                   Margin="0,0,8,0" />
                        <ui:Button Command="{Binding ToggleClickThroughCommand}"
                                   Content="穿透/交互" />
                    </StackPanel>
                    <ui:TextBlock Margin="0,14,0,0"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  Text="{Binding SessionStatus}" />
                    <ui:TextBlock Margin="0,4,0,0"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  Text="{Binding Status}" />
                </StackPanel>
            </ui:Card>

            <ui:Card>
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="已实现能力" />
                    <ui:TextBlock Margin="0,8,0,0" Text="• 官方 2D 底图、区域投影、区域/图层/分类筛选" />
                    <ui:TextBlock Text="• 读取 yysls.exe 实时坐标并在地图上显示玩家" />
                    <ui:TextBlock Text="• 悬浮游戏窗口、窗口/内容不透明度、Ctrl+Alt+M 穿透" />
                    <ui:TextBlock Text="• 标记详情、搜索、宏观路线与 JSON 快照" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
