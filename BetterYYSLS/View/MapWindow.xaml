<Window x:Class="BetterYYSLS.View.MapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BetterYYSLS.View.Controls"
        Title="大地图"
        Width="1280"
        Height="800"
        MinWidth="980"
        MinHeight="640"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="False"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStyle="None">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- 官方金色主按钮。 -->
        <Style x:Key="GoldButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#171A1F" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="#E7C36A"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F0D27A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#C9A64F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 官方顶部按钮和分类卡片的暗色金石样式。 -->
        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33D8B96A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 分类图标卡：整体可点，不显示原生复选框。 -->
        <Style x:Key="CategoryCardStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Card"
                                Padding="4,6"
                                Background="#FF4A4A4A"
                                BorderBrush="#FF5A5A5A"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#A88D52" />
                                <Setter TargetName="Card" Property="Background" Value="#302A22" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#7A673D" />
                                <Setter TargetName="Card" Property="Background" Value="#2D2821" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 一级分类导航的选中态使用官方金色。 -->
        <Style x:Key="PrimaryGroupItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#D8D2C4" />
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#33D8B96A" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E7C36A" />
                                <Setter Property="Foreground" Value="#171A1F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶部区域切换按钮保持透明暗色。 -->
        <Style x:Key="RegionComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="190" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="#F0E9D8" />
            <Setter Property="Background" Value="#3310151A" />
            <Setter Property="BorderBrush" Value="#77C9B27A" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid>
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="15"
                                       Foreground="#E8E1D2"
                                       Text="{Binding Name}" />
                            <Path Width="12"
                                  Height="8"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Data="M 0 0 L 6 6 L 12 0"
                                  Stroke="#C9B27A"
                                  StrokeThickness="1.5" />
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Height" Value="44" />
                        <Setter Property="Padding" Value="22,0" />
                        <Setter Property="Foreground" Value="#D8D2C4" />
                        <Setter Property="Background" Value="#3A3A3A" />
                        <Setter Property="BorderBrush" Value="#4A4A4A" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33D8B96A" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E7C36A" />
                                <Setter Property="Foreground" Value="#171A1F" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          Background="Transparent"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    IsHitTestVisible="False">
                                <Grid>
                                    <ContentPresenter Margin="10,0,28,0"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                    <Path Width="8"
                                          Height="5"
                                          Margin="0,0,10,0"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Data="M 0 0 L 4 4 L 8 0"
                                          Stroke="#C9B27A"
                                          StrokeThickness="1.5" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Width="430"
                                        MaxHeight="280"
                                        Background="#FF2E2E2E"
                                        BorderBrush="#77C9B27A"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayout"
              Margin="10">
        <Border x:Name="WindowFrame"
                Background="Transparent"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>

                <!-- 官方地图顶栏：纹样、LOGO、区域切换和窗口按钮。 -->
                <Border Grid.Row="0"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="OnHeaderMouseLeftButtonDown"
                        Opacity="{Binding WindowOpacity}">
                    <Border.Background>
                        <ImageBrush ImageSource="pack://application:,,,/BetterYYSLS;component/Assets/Map/containerBgLbl.png"
                                    Stretch="Fill" />
                    </Border.Background>
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="SimSun"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#E8E1D2"
                                       Text="燕云十六声" />
                            <Button x:Name="RegionButton"
                                    Margin="20,0,0,0"
                                    Padding="10,5"
                                    Background="#3310151A"
                                    BorderBrush="#77C9B27A"
                                    BorderThickness="1"
                                    Click="OnRegionSwitchClick"
                                    ToolTip="切换地图区域">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="13"
                                               Foreground="#F0E9D8"
                                               Text="{Binding SelectedRegionLabel}" />
                                    <TextBlock Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               Foreground="#B8AD94"
                                               Text="切换" />
                                    <Path Width="8"
                                          Height="5"
                                          Margin="8,0,0,0"
                                          Data="M 0 0 L 4 4 L 8 0"
                                          Stroke="#C9B27A"
                                          StrokeThickness="1.5" />
                                </StackPanel>
                            </Button>
                            <StackPanel Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <TextBlock Margin="0,0,6,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="#B8AD94"
                                           Text="不透明度" />
                                <Slider Width="88"
                                        Minimum="0.05"
                                        Maximum="1"
                                        Value="{Binding WindowOpacity, Mode=TwoWay}"
                                        ToolTip="地图与顶栏不透明度；路线和标记保持清晰" />
                                <TextBlock Width="38"
                                           Margin="4,0,8,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="#E8E1D2"
                                           Text="{Binding WindowOpacity, StringFormat={}{0:P0}}" />
                            </StackPanel>
                            <CheckBox Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      Content="始终置顶"
                                      Foreground="#E8E1D2"
                                      IsChecked="{Binding IsAlwaysOnTop, Mode=TwoWay}"
                                      ToolTip="始终显示在游戏窗口之上" />
                            <Popup x:Name="RegionPopup"
                                   Width="430"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="False"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=RegionButton}"
                                   PopupAnimation="Fade"
                                   StaysOpen="False">
                                <Border Background="#FF2E2E2E"
                                        BorderBrush="#77C9B27A"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                    <ScrollViewer MaxHeight="360"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding RegionGroups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <Grid>
                                                            <Button Click="OnRegionOptionClick"
                                                                    Height="44"
                                                                    Padding="22,0"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Background="#FF3A3A3A"
                                                                    BorderBrush="#FF4A4A4A"
                                                                    BorderThickness="0,0,0,1"
                                                                    DataContext="{Binding Region}">
                                                                <TextBlock VerticalAlignment="Center"
                                                                           FontSize="15"
                                                                           Foreground="#E8E1D2"
                                                                           Text="{Binding Name}" />
                                                            </Button>
                                                            <Button Width="42"
                                                                    HorizontalAlignment="Right"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Click="OnRegionGroupExpandClick"
                                                                    Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibility}}">
                                                                <Path Width="12"
                                                                      Height="8"
                                                                      Data="M 0 0 L 6 6 L 12 0"
                                                                      RenderTransformOrigin="0.5,0.5"
                                                                      Stroke="#C9B27A"
                                                                      StrokeThickness="1.5">
                                                                    <Path.Style>
                                                                        <Style TargetType="Path">
                                                                            <Setter Property="RenderTransform">
                                                                                <Setter.Value>
                                                                                    <RotateTransform Angle="0" />
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                    <Setter Property="RenderTransform">
                                                                                        <Setter.Value>
                                                                                            <RotateTransform Angle="180" />
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                            </Button>
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{Binding Children}"
                                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Click="OnRegionOptionClick"
                                                                            Height="38"
                                                                            Margin="20,2,0,2"
                                                                            Padding="22,0"
                                                                            HorizontalContentAlignment="Stretch"
                                                                            BorderThickness="1">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button">
                                                                                <Setter Property="Background" Value="#FF303030" />
                                                                                <Setter Property="BorderBrush" Value="#FF454545" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                        <Setter Property="Background" Value="#FF414141" />
                                                                                        <Setter Property="BorderBrush" Value="#FFF0E9D8" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                        <Grid>
                                                                            <TextBlock VerticalAlignment="Center"
                                                                                       FontSize="13"
                                                                                       Foreground="#CFC5AE"
                                                                                       Text="{Binding Name}" />
                                                                            <Path Width="14"
                                                                                  Height="10"
                                                                                  HorizontalAlignment="Right"
                                                                                  VerticalAlignment="Center"
                                                                                  Data="M 0 5 L 4 9 L 13 0"
                                                                                  Stroke="#F0E9D8"
                                                                                  StrokeThickness="2"
                                                                                  Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                                                        </Grid>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <CheckBox x:Name="ClickThroughButton"
                                      Margin="8,0,0,0"
                                      VerticalAlignment="Center"
                                      Content="鼠标穿透"
                                      FontSize="11"
                                      Foreground="#E8E1D2"
                                      IsChecked="{Binding IsClickThrough, Mode=TwoWay}"
                                      ToolTip="鼠标穿透：开启后移到顶部按钮，或按 Ctrl+Alt+M 退出" />
                            <CheckBox Margin="8,0,0,0"
                                      VerticalAlignment="Center"
                                      Content="隐藏已完成标点"
                                      FontSize="11"
                                      Foreground="#E8E1D2"
                                      IsChecked="{Binding HideCompleted, Mode=TwoWay}"
                                      ToolTip="隐藏已完成点位" />
                            <CheckBox Margin="8,0,0,0"
                                      VerticalAlignment="Center"
                                      Content="角色始终居中"
                                      FontSize="11"
                                      Foreground="#E8E1D2"
                                      IsChecked="{Binding IsPlayerCentered, Mode=TwoWay}"
                                      ToolTip="开启后角色保持居中，并跟随角色自动切换地图" />
                            <Button Command="{Binding RefreshCurrentResultsCommand}"
                                    Style="{StaticResource ChromeButtonStyle}"
                                    ToolTip="按当前选项重新计算">
                                <Image Width="18"
                                       Height="18"
                                       Source="pack://application:,,,/BetterYYSLS;component/Assets/Map/refresh.png"
                                       Stretch="Uniform" />
                            </Button>
                            <Button Click="OnMinimizeClick"
                                    Style="{StaticResource ChromeButtonStyle}"
                                    ToolTip="最小化">
                                <Image Width="16"
                                       Height="16"
                                       Source="pack://application:,,,/BetterYYSLS;component/Assets/Map/min.png"
                                       Stretch="Uniform" />
                            </Button>
                            <Button Command="{Binding ToggleFullScreenCommand}"
                                    Style="{StaticResource ChromeButtonStyle}"
                                    ToolTip="全屏">
                                <Image Width="16"
                                       Height="16"
                                       Source="pack://application:,,,/BetterYYSLS;component/Assets/Map/max.png"
                                       Stretch="Uniform" />
                            </Button>
                            <Button x:Name="CloseButton"
                                    Click="OnCloseClick"
                                    Style="{StaticResource ChromeButtonStyle}"
                                    ToolTip="关闭">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe UI"
                                           FontSize="18"
                                           FontWeight="Light"
                                           Foreground="#E8E1D2"
                                           Text="×" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SidebarColumn" Width="460" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 官方左侧面板：搜索、一级导航、二级分类和重置。 -->
                    <Border Grid.Column="0"
                            Background="#FF3A3A3A"
                            BorderBrush="#55C9B27A"
                            BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Margin="12,10,12,8"
                                    Background="#FF3F3F3F"
                                    BorderBrush="#FF5A5A5A"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="16"
                                           Height="16"
                                           Margin="10,0,0,0"
                                           Source="pack://application:,,,/BetterYYSLS;component/Assets/Map/search.png"
                                           Stretch="Uniform" />
                                    <TextBox x:Name="MapSearchBox"
                                             Grid.Column="1"
                                             Height="34"
                                             Padding="2,0,8,0"
                                             VerticalContentAlignment="Center"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             CaretBrush="#E7C36A"
                                             Foreground="#F0E9D8"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="搜索点位名称">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Margin="2,0,8,0"
                                                              Focusable="False"
                                                              HorizontalScrollBarVisibility="Hidden"
                                                              VerticalScrollBarVisibility="Hidden" />
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>
                                    <TextBlock Grid.Column="1"
                                               Margin="2,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               FontSize="12"
                                               Foreground="#8F8F8F"
                                               Text="搜索点位名称">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=MapSearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Text, ElementName=MapSearchBox}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="108" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ListBox ItemsSource="{Binding CategoryGroups}"
                                         DisplayMemberPath="Name"
                                         SelectedItem="{Binding SelectedCategoryGroup}"
                                         SelectionChanged="OnCategoryGroupSelectionChanged"
                                         ItemContainerStyle="{StaticResource PrimaryGroupItemStyle}"
                                         Background="#FF2F2F2F"
                                         BorderBrush="#332E25"
                                         BorderThickness="0,0,1,0"
                                         Foreground="#D8D2C4" />

                                <ScrollViewer x:Name="CategoryScroll"
                                              Grid.Column="1"
                                              Margin="5,0,0,0"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="CategoryItems"
                                                  ItemsSource="{Binding CategoryGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,12">
                                                    <TextBlock Margin="2,0,0,5"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#E8E1D2"
                                                               Text="{Binding Name}" />
                                                    <ItemsControl ItemsSource="{Binding Categories}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Columns="3" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                                          Style="{StaticResource CategoryCardStyle}"
                                                                          ToolTip="{Binding Name}">
                                                                    <StackPanel Width="86">
                                                                        <Image Width="32"
                                                                               Height="32"
                                                                               HorizontalAlignment="Center"
                                                                               Source="{Binding IconImage}"
                                                                               Stretch="Uniform" />
                                                                        <TextBlock Margin="0,3,0,0"
                                                                                   FontSize="10"
                                                                                   Foreground="#D8D2C4"
                                                                                   Text="{Binding Name}"
                                                                                   TextAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                </CheckBox>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <Grid Grid.Row="2" Margin="12,8,12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Command="{Binding SelectAllCategoriesCommand}"
                                        Content="全选"
                                        Height="36"
                                        Margin="0,0,4,0"
                                        Style="{StaticResource GoldButtonStyle}" />
                                <Button Grid.Column="1"
                                        Command="{Binding ClearSelectionCommand}"
                                        Content="重置"
                                        Height="36"
                                        Margin="4,0,0,0"
                                        Style="{StaticResource GoldButtonStyle}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 官方地图区域：底图、点位、隐藏完成开关和选中详情。 -->
                    <Border x:Name="MapFrame"
                            Grid.Column="1"
                            Background="Transparent"
                            ClipToBounds="True"
                            CornerRadius="0,0,10,0">
                        <Grid>
                            <controls:MapCanvas x:Name="MapView"
                                                Markers="{Binding FilteredMarkers}"
                                                BaseOpacity="{Binding WindowOpacity}"
                                                PlayerPosition="{Binding PlayerMapPosition}"
                                                FollowPlayer="{Binding IsPlayerCentered}"
                                                Region="{Binding SelectedRegion}"
                                                FocusPoint="{Binding FocusPoint}"
                                                LayerId="{Binding SelectedLayer.Id}"
                                                LayerLevel="{Binding SelectedLayer.Floor}"
                                                Route="{Binding CurrentRoute}"
                                                CompletionOf="{Binding CompletionLookup}"
                                                SelectedIds="{Binding SelectedMarkerIds}" />

                            <StackPanel Margin="12"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top">
                                <Button Command="{Binding OpenRoleDialogCommand}"
                                        Width="52"
                                        Height="52"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        Background="#332A2119"
                                        BorderBrush="#77C9B27A"
                                        BorderThickness="1"
                                        ToolTip="切换角色">
                                    <Border CornerRadius="26"
                                            ClipToBounds="True">
                                        <Image Width="46"
                                               Height="46"
                                               Source="{Binding SelectedRoleAvatar}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                </Button>
                            </StackPanel>

                            <StackPanel Margin="12"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top">
                                <Button Command="{Binding QuickLocateCommand}"
                                        Content="快速定位"
                                        Width="82"
                                        Height="34"
                                        Margin="0,0,0,6"
                                        Background="#CC1A1C22"
                                        BorderBrush="#77C9B27A"
                                        BorderThickness="1"
                                        Foreground="#E8E1D2" />
                                <Button x:Name="LayerButton"
                                        Click="OnLayerSwitchClick"
                                        Width="70"
                                        Height="70"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ToolTip="位面切换">
                                    <Border Width="64"
                                            Height="64"
                                            Background="#CC1A1C22"
                                            BorderBrush="#77C9B27A"
                                            BorderThickness="1"
                                            CornerRadius="32">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="#E8E1D2"
                                                   Text="位面&#x0a;切换"
                                                   TextAlignment="Center" />
                                    </Border>
                                </Button>
                                <Popup x:Name="LayerPopup"
                                       Width="100"
                                       Height="248"
                                       DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       IsOpen="False"
                                       Placement="Right"
                                       PlacementTarget="{Binding ElementName=LayerButton}"
                                       PopupAnimation="Fade"
                                       StaysOpen="False">
                                    <Border Width="100"
                                            Height="248"
                                            Background="#FF2E2E2E"
                                            BorderBrush="#554A3D2A"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                        <StackPanel Width="100">
                                            <ListBox Width="100"
                                                     Height="248"
                                                     ItemsSource="{Binding Layers}"
                                                     SelectedItem="{Binding SelectedLayer}"
                                                     SelectionChanged="OnLayerSelectionChanged"
                                                     Background="#FF2E2E2E"
                                                     BorderThickness="0"
                                                     Foreground="#E8E1D2">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <!-- 五个选项总高 248px：248 / 5 = 49.6px。 -->
                                                        <Setter Property="Width" Value="100" />
                                                        <Setter Property="Height" Value="49.6" />
                                                        <Setter Property="Padding" Value="12,0" />
                                                        <Setter Property="Background" Value="#FF3A3A3A" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#FF4A4438" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="White" />
                                                                <Setter Property="Foreground" Value="#171A1F" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Image x:Name="NormalIcon"
                                                                   HorizontalAlignment="Left"
                                                                   VerticalAlignment="Center"
                                                                   Source="{Binding IconUrl}"
                                                                   Stretch="Uniform">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Width" Value="26" />
                                                                        <Setter Property="Height" Value="26" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IconOnly}" Value="True">
                                                                                <Setter Property="Width" Value="88" />
                                                                                <Setter Property="Height" Value="40" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                            <Image x:Name="ActiveIcon"
                                                                   HorizontalAlignment="Left"
                                                                   VerticalAlignment="Center"
                                                                   Source="{Binding ActiveIconUrl}"
                                                                   Stretch="Uniform"
                                                                   Visibility="Collapsed">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Width" Value="26" />
                                                                        <Setter Property="Height" Value="26" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IconOnly}" Value="True">
                                                                                <Setter Property="Width" Value="88" />
                                                                                <Setter Property="Height" Value="40" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                            <TextBlock x:Name="LayerName"
                                                                       VerticalAlignment="Center"
                                                                       Text="{Binding Name}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Margin" Value="38,0,0,0" />
                                                                        <Setter Property="FontSize" Value="15" />
                                                                        <Setter Property="Foreground" Value="#D8D2C4" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IconOnly}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                         Value="True">
                                                                <Setter TargetName="NormalIcon" Property="Visibility" Value="Collapsed" />
                                                                <Setter TargetName="ActiveIcon" Property="Visibility" Value="Visible" />
                                                                <Setter TargetName="LayerName" Property="Foreground" Value="#171A1F" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>
                            <Border Margin="12"
                                    Padding="10,8"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Background="#FF101218"
                                    CornerRadius="5"
                                    IsHitTestVisible="False">
                                <StackPanel>
                                    <TextBlock FontSize="11"
                                               Foreground="#E8E1D2"
                                               Text="{Binding Status}" />
                                    <TextBlock FontSize="10"
                                               Foreground="#AAB0B8"
                                               Text="{Binding RouteSummary}" />
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="12"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom">
                                <Button Click="OnZoomInClick"
                                        Style="{StaticResource ChromeButtonStyle}"
                                        Width="44"
                                        Height="44"
                                        ToolTip="放大">
                                    <Image Width="34"
                                           Height="34"
                                           Source="pack://application:,,,/BetterYYSLS;component/Assets/Map/zoom-in.png"
                                           Stretch="Uniform" />
                                </Button>
                                <Slider Orientation="Vertical"
                                        Height="140"
                                        Width="26"
                                        Margin="0,4,0,4"
                                        Minimum="0.2"
                                        Maximum="128"
                                        Value="{Binding Zoom, ElementName=MapView, Mode=TwoWay}"
                                        IsSnapToTickEnabled="False"
                                        ToolTip="地图缩放" />
                                <Button Click="OnZoomOutClick"
                                        Style="{StaticResource ChromeButtonStyle}"
                                        Width="44"
                                        Height="44"
                                        ToolTip="缩小">
                                    <Image Width="34"
                                           Height="34"
                                           Source="pack://application:,,,/BetterYYSLS;component/Assets/Map/zoom-out.png"
                                           Stretch="Uniform" />
                                </Button>
                            </StackPanel>
                            <Border Margin="12"
                                    Padding="10"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    MaxWidth="300"
                                    Background="#FF101218"
                                    BorderBrush="#55C9B27A"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedMarker}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Width="32"
                                                   Height="32"
                                                   Margin="0,0,8,0"
                                                   Source="{Binding SelectedMarkerIcon}"
                                                   Stretch="Uniform" />
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="13"
                                                       Foreground="#E8E8E8"
                                                       Text="{Binding SelectedMarker.Title}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Width="24"
                                                Height="24"
                                                Margin="8,0,0,0"
                                                Padding="0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding CloseMarkerDetailsCommand}"
                                                Content="×"
                                                FontFamily="Segoe UI"
                                                FontSize="18"
                                                Foreground="#E8E8E8"
                                                ToolTip="关闭详情" />
                                    </Grid>
                                    <TextBlock FontSize="11"
                                               Foreground="#AAB0B8"
                                               Text="{Binding SelectedMarker.Description}"
                                               TextWrapping="Wrap" />
                                    <TextBlock FontSize="11"
                                               Foreground="#C7D2DF"
                                               Text="{Binding SelectedMarkerDetails.Description}"
                                               TextWrapping="Wrap" />
                                    <TextBlock FontSize="11"
                                               Foreground="#7FE0A0"
                                               Text="{Binding SelectedMarkerDetails.CompletionText}" />
                                    <TextBlock FontSize="10"
                                               Foreground="#7F8A99"
                                               Text="{Binding SelectedMarkerDetails.VisitText}" />
                                    <TextBlock FontSize="10"
                                               Foreground="#7F8A99"
                                               Text="{Binding SelectedMarkerInfo}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Button x:Name="SidebarToggleButton"
                            Grid.Column="1"
                            Panel.ZIndex="20"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="-20,10,0,0"
                            Width="36"
                            Height="36"
                            Click="OnToggleSidebarClick"
                            Style="{StaticResource ChromeButtonStyle}"
                            ToolTip="收起侧栏">
                        <Image x:Name="SidebarToggleIcon"
                               Width="24"
                               Height="24"
                               RenderTransformOrigin="0.5,0.5"
                               Source="pack://application:,,,/BetterYYSLS;component/Assets/Map/back.png"
                               Stretch="Uniform" />
                    </Button>
                </Grid>

                <!-- 官方角色选择弹窗。 -->
                <Grid Grid.RowSpan="3"
                      Panel.ZIndex="200"
                      Visibility="{Binding IsRoleDialogOpen, Converter={StaticResource BoolToVisibility}}">
                    <!-- 点击遮罩也能关闭角色弹窗，避免关闭叉异常时整张地图无法操作。 -->
                    <Button Background="#CC000000"
                            BorderThickness="0"
                            Command="{Binding CloseRoleDialogCommand}"
                            Focusable="False"
                            IsTabStop="False" />
                    <Border Width="540"
                            MaxHeight="620"
                            Padding="24,20,24,22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#FF252525"
                            BorderBrush="#554A3D2A"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 标题与关闭按钮分开占位，避免关闭叉被标题或滚动区域遮挡。 -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="#F0E9D8"
                                           Text="请选择角色" />
                                <Button x:Name="RoleDialogCloseButton"
                                        Grid.Column="1"
                                        Panel.ZIndex="20"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Width="36"
                                        Height="36"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding CloseRoleDialogCommand}"
                                        ToolTip="关闭">
                                    <Path Width="16"
                                          Height="16"
                                          Data="M 3 3 L 13 13 M 13 3 L 3 13"
                                          Stroke="#E8E1D2"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Button>
                            </Grid>

                            <StackPanel Grid.Row="1">
                                <TextBlock Margin="0,0,0,6"
                                           FontSize="12"
                                           Foreground="#8F8F8F"
                                           Text="输入角色 ID 自动查找服务器" />
                            <Border Height="44"
                                    Margin="0,0,0,10"
                                    Background="#FF303030"
                                    BorderBrush="#FF3B3B3B"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="16"
                                           Height="16"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Source="pack://application:,,,/BetterYYSLS;component/Assets/Map/search.png"
                                           Stretch="Uniform" />
                                    <TextBox x:Name="RoleIdBox"
                                             Grid.Column="1"
                                             Height="40"
                                             Padding="2,0,6,0"
                                             VerticalContentAlignment="Center"
                                             FocusVisualStyle="{x:Null}"
                                             SelectionBrush="#66E7C36A"
                                             FontSize="13"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             CaretBrush="#E7C36A"
                                             Foreground="#F0E9D8"
                                             Text="{Binding RoleInputId, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="输入角色 ID 后按回车或点击查找">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Margin="2,0,6,0"
                                                              Focusable="False"
                                                              HorizontalScrollBarVisibility="Hidden"
                                                              VerticalScrollBarVisibility="Hidden" />
                                            </ControlTemplate>
                                        </TextBox.Template>
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding LookupRoleCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <TextBlock Grid.Column="1"
                                               Margin="2,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               FontSize="12"
                                               Foreground="#8F8F8F"
                                               Text="输入角色 ID，例如 0264890060">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=RoleIdBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Text, ElementName=RoleIdBox}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="2"
                                            Width="48"
                                            Height="30"
                                            Margin="0,0,6,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding LookupRoleCommand}"
                                            Content="查找"
                                            Cursor="Hand"
                                            FontSize="12"
                                            Foreground="#C9B27A"
                                            ToolTip="按输入的角色 ID 查找并切换" />
                                </Grid>
                            </Border>
                            </StackPanel>

                            <TextBlock Grid.Row="2"
                                       Margin="0,0,0,8"
                                       FontSize="11"
                                       Foreground="#C9B27A"
                                       Text="{Binding RoleStatus}"
                                       TextWrapping="Wrap" />

                                <ScrollViewer Grid.Row="3"
                                              MaxHeight="300"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding RoleChoices}"
                                                  HorizontalAlignment="Stretch">
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Button Padding="0"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Command="{Binding DataContext.SelectRoleChoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                    <Border x:Name="RoleRow"
                                                            MinHeight="68"
                                                            Padding="12,8"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#FF303030" />
                                                                <Setter Property="BorderBrush" Value="#FF3B3B3B" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="#FF3B342A" />
                                                                        <Setter Property="BorderBrush" Value="#E7C36A" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="54" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="30" />
                                                                <ColumnDefinition Width="32" />
                                                            </Grid.ColumnDefinitions>
                                                            <Image Width="44"
                                                                   Height="44"
                                                                   HorizontalAlignment="Left"
                                                                   Source="{Binding Avatar}"
                                                                   Stretch="UniformToFill">
                                                                <Image.Clip>
                                                                    <EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22" />
                                                                </Image.Clip>
                                                            </Image>
                                                            <StackPanel Grid.Column="1"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock FontSize="15"
                                                                           Foreground="#F0E9D8"
                                                                           Text="{Binding DisplayText}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Margin="0,3,0,0"
                                                                           FontSize="11"
                                                                           Foreground="#AAB0B8"
                                                                           Text="{Binding ServerName}" />
                                                            </StackPanel>
                                                            <CheckBox Grid.Column="2"
                                                                      Width="20"
                                                                      Height="20"
                                                                      Margin="0,0,2,0"
                                                                      HorizontalAlignment="Right"
                                                                      VerticalAlignment="Center"
                                                                      Panel.ZIndex="1"
                                                                      IsChecked="{Binding IsSelected}"
                                                                      IsHitTestVisible="False">
                                                                <CheckBox.Template>
                                                                    <ControlTemplate TargetType="CheckBox">
                                                                        <Border x:Name="Box"
                                                                                Width="20"
                                                                                Height="20"
                                                                                Background="Transparent"
                                                                                BorderBrush="#FF8A8A8A"
                                                                                BorderThickness="1.5"
                                                                                CornerRadius="4">
                                                                            <Path x:Name="CheckMark"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Data="M 0 4 L 4 8 L 10 1"
                                                                                  Stroke="White"
                                                                                  StrokeThickness="2"
                                                                                  Visibility="Collapsed" />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                <Setter TargetName="Box" Property="Background" Value="#FFFF3B45" />
                                                                                <Setter TargetName="Box" Property="BorderBrush" Value="#FFFF3B45" />
                                                                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </CheckBox.Template>
                                                            </CheckBox>
                                                            <Button Grid.Column="3"
                                                                    Width="28"
                                                                    Height="28"
                                                                    Margin="2,0,0,0"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Panel.ZIndex="3"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Command="{Binding DataContext.RemoveRoleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Cursor="Hand"
                                                                    ToolTip="移除角色"
                                                                    Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}">
                                                                <Path Width="12"
                                                                      Height="12"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Data="M 2 2 L 10 10 M 10 2 L 2 10"
                                                                      Stroke="#AAB0B8"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      StrokeThickness="2" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                            <Grid Grid.Row="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Margin="0,6,0,12"
                                           HorizontalAlignment="Center"
                                           FontSize="11"
                                           Foreground="#8F8F8F"
                                           Text="查不到角色时可直接输入角色 ID" />
                                <Button Grid.Row="1"
                                        Height="44"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Background="#FFFF3B45"
                                        BorderThickness="0"
                                        Command="{Binding ConfirmRoleDialogCommand}"
                                        Content="确定"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="White" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 底部状态栏保留同步、坐标和路线摘要，不占用官方主视觉。 -->
                <Border Grid.Row="2"
                        Background="#151820"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="0,1,0,0">
                    <Grid Margin="14,0">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock FontSize="10"
                                       Foreground="#AAB0B8"
                                       Text="{Binding LocationStatus}" />
                            <TextBlock Margin="12,0,0,0"
                                       FontSize="10"
                                       Foreground="#7F8A99"
                                       Text="{Binding SessionStatus}" />
                            <TextBlock Margin="12,0,0,0"
                                       FontSize="10"
                                       Foreground="#E7C36A"
                                       Text="{Binding RouteSummary}" />
                            <TextBlock Margin="12,0,0,0"
                                       FontSize="10"
                                       Foreground="#C9B27A"
                                       Text="{Binding CompletionStatus}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
